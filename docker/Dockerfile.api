# ============================================================
# Farm Phone AI Office — API Dockerfile (NestJS)
# ============================================================
FROM node:20-alpine AS builder

RUN apk add --no-cache openssl

WORKDIR /app

# Copy root configs
COPY package.json package-lock.json turbo.json tsconfig.base.json ./

# Copy package.json files for monorepo install
COPY packages/config/package.json packages/config/
COPY packages/database/package.json packages/database/
COPY packages/types/package.json packages/types/
COPY packages/events/package.json packages/events/
COPY packages/ui/package.json packages/ui/

# Copy apps/api configs
COPY apps/api/package.json apps/api/
COPY apps/api/tsconfig.json apps/api/tsconfig.build.json apps/api/nest-cli.json apps/api/

# Install exactly the dependency graph recorded in the lockfile
RUN npm ci

# Copy all source
COPY packages/ packages/
COPY apps/api/ apps/api/

# Generate Prisma model types before compiling the database workspace
RUN cd packages/database && npx prisma generate

# Build runtime workspace packages and NestJS
RUN npm run build --workspace @farm-phone/api

# ---- Production Stage ----
FROM node:20-alpine

RUN apk add --no-cache openssl

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api/dist ./dist
COPY --from=builder /app/apps/api/package.json ./package.json

# Prisma client generation
COPY --from=builder /app/packages/database/prisma ./packages/database/prisma
COPY --from=builder /app/packages/database/package.json ./packages/database/package.json

RUN cd packages/database && npx prisma generate

EXPOSE 3001

CMD ["node", "dist/main.js"]
