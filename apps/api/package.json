{
  "name": "@farm-phone/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:dependencies": "npm run build --workspace @farm-phone/types && npm run build --workspace @farm-phone/config && npm run build --workspace @farm-phone/database && npm run build --workspace @farm-phone/events",
    "predev": "npm run build:dependencies",
    "dev": "node dist/main",
    "prebuild": "npm run build:dependencies",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:mock": "jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:live-device": "node --test ../../tests/live-one-device.contract.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "cd ../../packages/database && npx prisma generate",
    "db:migrate": "cd ../../packages/database && npx prisma migrate dev"
  },
  "dependencies": {
    "@farm-phone/config": "*",
    "@farm-phone/database": "*",
    "@farm-phone/events": "*",
    "@farm-phone/types": "*",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "^4.0.4",
    "@opentelemetry/api": "^1.9.0",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/websockets": "11.1.28",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^14.2.0",
    "ioredis": "^5.4.0",
    "minio": "^8.0.7",
    "openai": "^6.49.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.4",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
